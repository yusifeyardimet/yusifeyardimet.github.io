        // ═══════════════════════════════════════════════════════════
        // STATE
        // ═══════════════════════════════════════════════════════════
        let currentLang = localStorage.getItem('yusif-lang') || 'az';
        if (!['az', 'ru', 'en'].includes(currentLang)) currentLang = 'az';

        // ═══════════════════════════════════════════════════════════
        // LANGUAGE APPLICATION
        // ═══════════════════════════════════════════════════════════
        function applyLanguage(lang) {
            if (!TRANSLATIONS[lang]) lang = 'az';
            currentLang = lang;
            localStorage.setItem('yusif-lang', lang);
            document.documentElement.lang = lang;

            const t = TRANSLATIONS[lang];

            // Update all [data-i18n] elements
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.dataset.i18n;
                if (t[key] !== undefined) {
                    if (/<[^>]+>/.test(t[key])) {
                        el.innerHTML = t[key];
                    } else {
                        el.textContent = t[key];
                    }
                }
            });

            // Update language buttons (all instances, mobile + desktop)
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });

            // Update last-updated date in selected language
            updateLastUpdatedDate();

            // Update bank cards (re-render copy buttons + cardholder label)
            renderDonationCards();

            // Update share links
            updateShareLinks();
        }

        // ═══════════════════════════════════════════════════════════
        // DATE — Show today's date in current language
        // ═══════════════════════════════════════════════════════════
        function updateLastUpdatedDate() {
            const t = TRANSLATIONS[currentLang];
            const d = new Date();
            const dateStr = `${d.getDate()} ${t.monthNames[d.getMonth()]} ${d.getFullYear()}`;
            const el = document.getElementById('lastUpdatedDate');
            if (el) el.textContent = dateStr;
        }

        // ═══════════════════════════════════════════════════════════
        // RENDER BANK CARDS
        // ═══════════════════════════════════════════════════════════
        function renderDonationCards() {
            const grid = document.getElementById('donationGrid');
            const t = TRANSLATIONS[currentLang];
            grid.innerHTML = '';

            SITE.bankAccounts.forEach((account, idx) => {
                const card = document.createElement('div');
                card.className = 'bank-card reveal reveal-delay-' + ((idx % 4) + 1);
                card.innerHTML = `
                    <div class="bank-name">${account.bankName}</div>
                    <div class="bank-number">${account.cardNumber}</div>
                    <button class="bank-copy-btn" type="button" data-card="${account.cardNumber.replace(/\s/g, '')}">
                        📋 ${t.copyBtn}
                    </button>
                    <div class="bank-holder">
                        <strong>${t.cardHolderLabel}</strong><br>
                        ${SITE.cardHolderName}
                    </div>
                `;
                grid.appendChild(card);
            });

            // Attach copy handlers + re-observe for reveal animation
            grid.querySelectorAll('.bank-copy-btn').forEach(btn => {
                btn.addEventListener('click', () => copyCardNumber(btn));
            });
            grid.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
        }

        // ═══════════════════════════════════════════════════════════
        // COPY TO CLIPBOARD + Meta Pixel AddToCart event
        // Uses execCommand exclusively — navigator.clipboard.writeText()
        // triggers Android's "Edit/Share" system overlay; execCommand
        // copies silently and matches our own toast UX better.
        // ═══════════════════════════════════════════════════════════
        function execCopy(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.setAttribute('readonly', ''); // suppresses mobile keyboard
            textarea.setAttribute('aria-hidden', 'true');
            // Position off-screen but inside viewport (required for iOS focus)
            textarea.style.position = 'fixed';
            textarea.style.top = '0';
            textarea.style.left = '0';
            textarea.style.width = '1px';
            textarea.style.height = '1px';
            textarea.style.padding = '0';
            textarea.style.border = 'none';
            textarea.style.outline = 'none';
            textarea.style.boxShadow = 'none';
            textarea.style.background = 'transparent';
            textarea.style.opacity = '0';
            textarea.style.pointerEvents = 'none';
            document.body.appendChild(textarea);

            // Preserve current focus + scroll
            const prevFocus = document.activeElement;
            const prevScrollY = window.scrollY;

            textarea.focus({ preventScroll: true });
            textarea.select();
            textarea.setSelectionRange(0, 99999); // iOS Safari

            let success = false;
            try { success = document.execCommand('copy'); } catch (e) {}

            document.body.removeChild(textarea);
            if (prevFocus && typeof prevFocus.focus === 'function') {
                prevFocus.focus({ preventScroll: true });
            }
            window.scrollTo({ top: prevScrollY, behavior: 'instant' });
            return success;
        }

        // Copies the card number to clipboard AND visually selects it.
        // The visual selection acts as extra confirmation feedback.
        //
        // Note on Xiaomi/MIUI/HyperOS: their "Universal Clipboard" feature
        // shows a system "Düzənlə/Paylaş" overlay on every clipboard write —
        // this is an OS-level feature JavaScript cannot suppress. User can
        // disable it in: Settings → Additional Settings → Universal Clipboard.
        function copyCardNumber(button) {
            const cardNumber = button.dataset.card;
            const t = TRANSLATIONS[currentLang];

            // Visually highlight the card number (extra feedback)
            const card = button.closest('.bank-card');
            const numberEl = card ? card.querySelector('.bank-number') : null;
            if (numberEl) {
                const range = document.createRange();
                range.selectNodeContents(numberEl);
                const selection = window.getSelection();
                if (selection) {
                    selection.removeAllRanges();
                    selection.addRange(range);
                }
            }

            // Actually copy to clipboard
            const success = execCopy(cardNumber);
            if (!success) return;

            button.classList.add('copied');
            button.innerHTML = `✓ ${t.copyBtn === 'Copy' ? 'Copied' : t.copyBtn === 'Копировать' ? 'Скопировано' : 'Kopyalandı'}`;

            // Meta Pixel: AddToCart event when card is copied
            if (typeof fbq !== 'undefined') {
                fbq('track', 'AddToCart', {
                    content_name: 'Bank Card Copy',
                    content_category: 'Donation',
                    content_ids: [cardNumber.substring(0, 4)],
                    value: 0,
                    currency: 'AZN'
                });
            }

            showToast(t.copiedToast);

            // Open the transfer guide modal ~600ms after the toast appears,
            // giving the toast a moment to register visually first. The
            // copied card number is shown inside the modal as confirmation.
            setTimeout(() => {
                if (typeof openTransferGuide === 'function') openTransferGuide(cardNumber);
            }, 600);

            setTimeout(() => {
                button.classList.remove('copied');
                button.innerHTML = `📋 ${t.copyBtn}`;
            }, 2400);
        }

        // ═══════════════════════════════════════════════════════════
        // TOAST
        // ═══════════════════════════════════════════════════════════
        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastText').textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 2400);
        }

        // ═══════════════════════════════════════════════════════════
        // SHARE LINKS
        // ═══════════════════════════════════════════════════════════
        function updateShareLinks() {
            const t = TRANSLATIONS[currentLang];
            const url = window.location.href;
            const text = `${t.shareText} ${url}`;
            document.getElementById('shareWhatsApp').href = `https://wa.me/?text=${encodeURIComponent(text)}`;
            document.getElementById('shareFacebook').href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
        }

        // ═══════════════════════════════════════════════════════════
        // INSTAGRAM SHARE (copy link + open IG)
        // ═══════════════════════════════════════════════════════════
        function setupInstagramShare() {
            document.getElementById('shareInstagram').addEventListener('click', (e) => {
                e.preventDefault();
                const t = TRANSLATIONS[currentLang];
                // execCommand avoids Android system clipboard overlay
                execCopy(window.location.href);
                showToast(t.instagramAlert);
                setTimeout(() => window.open('https://www.instagram.com/', '_blank'), 600);
            });
        }

        // ═══════════════════════════════════════════════════════════
        // LIGHTBOX (gallery + documents)
        //
        // Uses History API so Android's back button closes the lightbox
        // instead of leaving the site. Pattern:
        //   open()  -> history.pushState({yusifLightbox: true})
        //   close UI (X / ESC / backdrop) -> history.back() -> popstate
        //   popstate listener -> actually remove the .active class
        // ═══════════════════════════════════════════════════════════
        function setupLightbox() {
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightboxImg');
            const lightboxClose = document.getElementById('lightboxClose');
            let isOpen = false;

            const open = (src, alt) => {
                lightboxImg.src = src;
                lightboxImg.alt = alt || '';
                lightbox.classList.add('active');
                document.body.style.overflow = 'hidden';
                if (!isOpen) {
                    isOpen = true;
                    // Push a history entry so the OS back gesture pops it
                    history.pushState({ yusifLightbox: true }, '');
                }
            };

            // User-driven close (X button, ESC, backdrop click)
            // Triggers history.back() which fires popstate -> finalize()
            const requestClose = () => {
                if (!isOpen) return;
                if (history.state && history.state.yusifLightbox) {
                    history.back();
                } else {
                    // History entry already gone (rare); just finalize
                    finalize();
                }
            };

            // Actually tears down the lightbox
            const finalize = () => {
                lightbox.classList.remove('active');
                document.body.style.overflow = '';
                setTimeout(() => { lightboxImg.src = ''; }, 300);
                isOpen = false;
            };

            document.querySelectorAll('[data-img]').forEach(el => {
                el.addEventListener('click', () => {
                    const img = el.querySelector('img');
                    open(el.dataset.img, img ? img.alt : '');
                });
            });
            lightboxClose.addEventListener('click', requestClose);
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) requestClose();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && isOpen) requestClose();
            });

            // OS-level back gesture / browser back button
            window.addEventListener('popstate', () => {
                if (isOpen) finalize();
            });
        }

        // ═══════════════════════════════════════════════════════════
        // TRANSFER GUIDE MODAL
        //
        // Opens after a card is copied. Shows clear, app-agnostic transfer
        // instructions plus optional download cards for local banking apps.
        // No deep-link guessing — App Store / Play Store routing only when
        // user explicitly taps a download card. Mirrors the lightbox History
        // API pattern so the OS back gesture closes the modal.
        // ═══════════════════════════════════════════════════════════
        let openTransferGuide = (cardNumber) => {}; // assigned by setupTransferGuide

        function setupTransferGuide() {
            const modal = document.getElementById('transferGuide');
            const closeX = document.getElementById('transferGuideCloseX');
            const closeBtn = document.getElementById('transferGuideCloseBtn');
            const cardNumberEl = document.getElementById('transferGuideCardNumber');
            if (!modal || !closeX || !closeBtn) return;
            let isOpen = false;

            const open = (cardNumber) => {
                if (cardNumberEl && cardNumber) {
                    cardNumberEl.textContent = cardNumber;
                }
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
                if (!isOpen) {
                    isOpen = true;
                    history.pushState({ yusifTransferGuide: true }, '');
                }
                // Move focus to the close button for accessibility
                setTimeout(() => { try { closeBtn.focus(); } catch (e) {} }, 100);
            };

            const requestClose = () => {
                if (!isOpen) return;
                if (history.state && history.state.yusifTransferGuide) {
                    history.back();
                } else {
                    finalize();
                }
            };

            const finalize = () => {
                modal.classList.remove('active');
                document.body.style.overflow = '';
                isOpen = false;
            };

            closeX.addEventListener('click', requestClose);
            closeBtn.addEventListener('click', requestClose);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) requestClose();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && isOpen) requestClose();
            });
            window.addEventListener('popstate', () => {
                if (isOpen) finalize();
            });

            // Smart store routing: pick iOS / Android / fallback link per device.
            // Only triggers when the user explicitly taps a download card.
            modal.querySelectorAll('.transfer-guide-app').forEach(item => {
                item.addEventListener('click', () => {
                    const ua = navigator.userAgent;
                    let url = item.dataset.android || item.href;
                    if (/iPhone|iPad|iPod/i.test(ua) && item.dataset.ios) {
                        url = item.dataset.ios;
                    } else if (/Android/i.test(ua) && item.dataset.android) {
                        url = item.dataset.android;
                    }
                    item.setAttribute('href', url);
                });
            });

            // Expose open() so copyCardNumber can trigger it with the copied number
            openTransferGuide = open;
        }

        // ═══════════════════════════════════════════════════════════
        // NAVIGATION (scroll state + mobile menu)
        // ═══════════════════════════════════════════════════════════
        function setupNavigation() {
            const nav = document.getElementById('nav');
            const mobileToggle = document.getElementById('mobileToggle');
            const mobileClose = document.getElementById('mobileClose');
            const mobileMenu = document.getElementById('mobileMenu');

            const onScroll = () => {
                nav.classList.toggle('scrolled', window.scrollY > 60);
                // Floating donate button — visible after hero
                const floating = document.getElementById('floatingDonate');
                const hero = document.getElementById('hero');
                if (hero && floating) {
                    floating.classList.toggle('visible', window.scrollY > hero.offsetHeight - 100);
                }
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();

            mobileToggle.addEventListener('click', () => {
                nav.classList.add('mobile-open');
                document.body.style.overflow = 'hidden';
            });
            mobileClose.addEventListener('click', () => {
                nav.classList.remove('mobile-open');
                document.body.style.overflow = '';
            });
            // Close mobile menu on link click
            mobileMenu.querySelectorAll('a').forEach(a => {
                a.addEventListener('click', () => {
                    nav.classList.remove('mobile-open');
                    document.body.style.overflow = '';
                });
            });
        }

        // ═══════════════════════════════════════════════════════════
        // SCROLL ANIMATIONS (Intersection Observer)
        // ═══════════════════════════════════════════════════════════
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    revealObserver.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

        function observeReveals() {
            document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
        }

        // ═══════════════════════════════════════════════════════════
        // HERO PARALLAX (subtle, desktop only)
        // ═══════════════════════════════════════════════════════════
        function setupHeroParallax() {
            if (window.innerWidth <= 768) return;
            const heroBg = document.getElementById('heroBg');
            let ticking = false;
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        const y = window.scrollY;
                        if (y < window.innerHeight) {
                            heroBg.style.transform = `translateY(${y * 0.3}px) scale(1.05)`;
                        }
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        }

        // ═══════════════════════════════════════════════════════════
        // LANGUAGE BUTTONS — bind once for all instances
        // ═══════════════════════════════════════════════════════════
        function setupLanguageButtons() {
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.addEventListener('click', () => applyLanguage(btn.dataset.lang));
            });
        }

        // ═══════════════════════════════════════════════════════════
        // SCROLL INDICATOR (clickable + hides on scroll)
        // ═══════════════════════════════════════════════════════════
        function setupScrollIndicator() {
            const indicator = document.getElementById('scrollIndicator');
            const story = document.getElementById('story');
            if (!indicator || !story) return;

            const goToStory = () => story.scrollIntoView({ behavior: 'smooth' });
            indicator.addEventListener('click', goToStory);
            indicator.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    goToStory();
                }
            });

            // Hide indicator after 100px scroll (rAF throttled)
            let ticking = false;
            window.addEventListener('scroll', () => {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        indicator.classList.toggle('hidden', window.scrollY > 100);
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });
        }

        // ═══════════════════════════════════════════════════════════
        // FLOATING WHATSAPP (2s entry delay + Contact pixel event)
        // ═══════════════════════════════════════════════════════════
        function setupFloatingWhatsapp() {
            const btn = document.getElementById('floatWhatsapp');
            if (!btn) return;

            // Show after 2s delay so it doesn't compete with hero on load
            setTimeout(() => btn.classList.add('visible'), 2000);

            // Track Contact via Meta Pixel
            btn.addEventListener('click', () => {
                if (typeof fbq !== 'undefined') {
                    fbq('track', 'Contact', {
                        content_name: 'WhatsApp Float Button',
                        content_category: 'Donation Contact'
                    });
                }
            });
        }

        // ═══════════════════════════════════════════════════════════
        // INIT
        // ═══════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', () => {
            renderDonationCards();
            setupLanguageButtons();
            setupNavigation();
            setupLightbox();
            setupTransferGuide();
            setupInstagramShare();
            setupHeroParallax();
            setupScrollIndicator();
            setupFloatingWhatsapp();
            observeReveals();
            applyLanguage(currentLang);
        });
    </script>
</body>
</html>
