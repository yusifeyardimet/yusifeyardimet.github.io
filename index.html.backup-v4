    <style>
        /* ============================================
           DESIGN SYSTEM - Variables
           ============================================ */
        :root {
            --bg-primary: #FFFAF5;
            --bg-elevated: #FFFFFF;
            --bg-warm: #F5EFE6;
            --accent-gold: #C9A961;
            --accent-gold-dark: #A88A4A;
            --accent-warm: #8B5A2B;
            --text-primary: #2C2416;
            --text-secondary: #6B5D4F;
            --text-muted: #9B8B7A;
            --urgent: #E63946;
            --success: #4CAF50;
            --whatsapp: #25D366;
            --facebook: #1877F2;

            --shadow-sm: 0 2px 8px rgba(44, 36, 22, 0.06);
            --shadow-md: 0 8px 24px rgba(44, 36, 22, 0.10);
            --shadow-lg: 0 16px 48px rgba(44, 36, 22, 0.15);
            --shadow-xl: 0 24px 64px rgba(44, 36, 22, 0.20);

            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-xl: 32px;

            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-slow: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);

            --container: 1200px;
            --section-pad-y: 120px;
            --section-pad-y-mobile: 60px;
        }

        /* ============================================
           Reset & Base
           ============================================ */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            font-weight: 400;
            font-size: 18px;
            line-height: 1.7;
            color: var(--text-primary);
            background: var(--bg-primary);
            overflow-x: hidden;
            /* Prevent accidental selection on tap (mobile UX) */
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Allow text selection on readable content (manual copy, translation) */
        .hero-title, .hero-subtitle,
        .section-title, .section-subtitle,
        .story-text, .story-text p, .story-text strong, .story-signature,
        .impact-amount, .impact-description,
        .gallery-caption,
        .doc-title,
        .bank-name, .bank-number, .bank-holder, .bank-holder strong,
        .footer-text, .footer-contact {
            -webkit-user-select: text;
            -moz-user-select: text;
            -ms-user-select: text;
            user-select: text;
        }

        img {
            max-width: 100%;
            display: block;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            background: none;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Typography utility classes */
        .serif {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* ============================================
           Scroll Animations
           ============================================ */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .reveal-delay-1 { transition-delay: 0.1s; }
        .reveal-delay-2 { transition-delay: 0.2s; }
        .reveal-delay-3 { transition-delay: 0.3s; }
        .reveal-delay-4 { transition-delay: 0.4s; }

        /* ============================================
           Navigation
           ============================================ */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            padding: 20px 0;
            transition: var(--transition);
            background: transparent;
        }

        .nav.scrolled {
            background: rgba(255, 250, 245, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: var(--shadow-sm);
            padding: 14px 0;
        }

        .nav-inner {
            max-width: var(--container);
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: white;
            letter-spacing: -0.5px;
            transition: var(--transition);
        }

        .nav.scrolled .nav-logo {
            color: var(--text-primary);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        /* Language Switcher */
        .lang-switcher {
            display: flex;
            gap: 4px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 4px;
            border-radius: 999px;
            transition: var(--transition);
        }

        .nav.scrolled .lang-switcher {
            background: var(--bg-warm);
        }

        .lang-btn {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 600;
            color: white;
            transition: var(--transition);
        }

        .nav.scrolled .lang-btn {
            color: var(--text-secondary);
        }

        .lang-btn.active {
            background: var(--accent-gold);
            color: white;
        }

        .nav.scrolled .lang-btn.active {
            color: white;
        }

        /* CTA Button */
        .btn-cta {
            background: var(--accent-gold);
            color: white;
            padding: 12px 28px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.3px;
            transition: var(--transition);
            box-shadow: 0 4px 20px rgba(201, 169, 97, 0.4);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-cta:hover {
            background: var(--accent-gold-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(201, 169, 97, 0.5);
        }

        .btn-cta:active {
            transform: translateY(0);
        }

        /* Mobile menu */
        .nav-mobile-toggle {
            display: none;
            color: white;
            font-size: 24px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 10px;
            border-radius: 50%;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
        }

        .nav.scrolled .nav-mobile-toggle {
            color: var(--text-primary);
            background: var(--bg-warm);
        }

        /* ============================================
           Hero Section
           ============================================ */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image: url('yusif-main.jpg');
            background-size: cover;
            background-position: center 30%;
            transition: transform 0.5s ease-out;
            will-change: transform;
        }

        .hero-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(0, 0, 0, 0.2) 0%,
                rgba(0, 0, 0, 0.3) 40%,
                rgba(0, 0, 0, 0.7) 80%,
                rgba(0, 0, 0, 0.9) 100%
            );
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            padding: 0 24px;
            max-width: 900px;
        }

        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(56px, 12vw, 140px);
            font-weight: 700;
            line-height: 1;
            letter-spacing: -3px;
            margin-bottom: 20px;
            text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            animation: heroFadeIn 1.2s ease;
        }

        .hero-subtitle {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: clamp(20px, 2.8vw, 30px);
            font-weight: 400;
            font-style: italic;
            letter-spacing: 0;
            line-height: 1.4;
            margin-bottom: 48px;
            opacity: 0.95;
            text-shadow: 0 2px 16px rgba(0, 0, 0, 0.55);
            animation: heroFadeIn 1.2s ease 0.3s both;
        }

        .hero-cta {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--accent-gold);
            color: white;
            padding: 20px 44px;
            border-radius: 999px;
            font-size: 17px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: var(--transition);
            box-shadow: 0 8px 40px rgba(201, 169, 97, 0.5);
            animation: heroFadeIn 1.2s ease 0.6s both, ctaPulse 2.5s ease 2s infinite;
        }

        .hero-cta:hover {
            background: var(--accent-gold-dark);
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 50px rgba(201, 169, 97, 0.6);
            animation: heroFadeIn 1.2s ease 0.6s both;
        }

        .hero-cta-icon {
            font-size: 20px;
            display: inline-block;
            transition: transform 0.3s ease;
        }

        .hero-cta:hover .hero-cta-icon {
            transform: scale(1.2) rotate(-10deg);
        }

        @keyframes heroFadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes ctaPulse {
            0%, 100% {
                box-shadow: 0 8px 40px rgba(201, 169, 97, 0.5);
            }
            50% {
                box-shadow: 0 8px 60px rgba(201, 169, 97, 0.8), 0 0 0 12px rgba(201, 169, 97, 0.15);
            }
        }

        /* Last updated badge */
        .last-updated-badge {
            position: absolute;
            top: 90px;
            right: 24px;
            z-index: 2;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 999px;
            color: white;
            font-size: 13px;
            font-weight: 500;
            border: 1px solid rgba(255, 255, 255, 0.2);
            animation: heroFadeIn 1.2s ease 0.9s both;
        }

        /* Scroll indicator (clickable, hides on scroll) */
        .scroll-indicator {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2;
            color: rgba(255, 255, 255, 0.92);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 500;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            white-space: nowrap;
            text-align: center;
            cursor: pointer;
            user-select: none;
            transition: opacity 0.5s ease, transform 0.3s ease;
            animation: scrollIndicatorFadeIn 1.2s ease 0.9s both;
            will-change: opacity, transform;
        }

        .scroll-indicator:hover,
        .scroll-indicator:focus-visible {
            opacity: 1;
            color: white;
            transform: translateX(-50%) scale(1.08);
            outline: none;
        }

        .scroll-indicator.hidden {
            transform: translateX(-50%) translateY(0);
        }

        .scroll-indicator.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .scroll-indicator-arrows {
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 1;
        }

        .scroll-chevron {
            display: block;
            width: 22px;
            height: 22px;
            color: white;
            animation: chevronBounce 1.8s ease-in-out infinite;
            will-change: transform;
        }

        .scroll-chevron-2 {
            margin-top: -11px;
            animation-delay: 0.2s;
            opacity: 0.6;
        }

        .scroll-indicator:hover .scroll-chevron,
        .scroll-indicator:focus-visible .scroll-chevron {
            animation-play-state: paused;
        }

        @keyframes chevronBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(8px); }
        }

        /* Scroll indicator entry — preserves translateX(-50%) for centering */
        @keyframes scrollIndicatorFadeIn {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        /* ============================================
           Story Section
           ============================================ */
        .story {
            padding: var(--section-pad-y) 0;
            background: var(--bg-primary);
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(36px, 5vw, 56px);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -1.5px;
            color: var(--text-primary);
            margin-bottom: 24px;
            text-align: center;
        }

        .section-subtitle {
            font-size: clamp(16px, 1.5vw, 19px);
            color: var(--text-secondary);
            text-align: center;
            max-width: 600px;
            margin: 0 auto 64px;
            line-height: 1.7;
        }

        .story-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
            margin-top: 64px;
        }

        .story-image {
            position: relative;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            aspect-ratio: 4/5;
        }

        .story-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .story-image:hover img {
            transform: scale(1.03);
        }

        .story-image::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(45deg, rgba(201, 169, 97, 0.15), transparent 50%);
            z-index: 1;
            pointer-events: none;
        }

        .story-text {
            font-size: 18px;
            line-height: 1.8;
            color: var(--text-secondary);
        }

        .story-text p {
            margin-bottom: 20px;
        }

        .story-text .lead {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-style: italic;
            color: var(--text-primary);
            margin-bottom: 28px;
            line-height: 1.4;
        }

        .story-text strong {
            color: var(--text-primary);
            font-weight: 600;
        }

        .story-signature {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 2px solid var(--accent-gold);
            font-style: italic;
            color: var(--accent-warm);
            font-weight: 500;
        }

        /* ============================================
           Impact Section
           ============================================ */
        .impact {
            padding: var(--section-pad-y) 0;
            background: var(--bg-warm);
        }

        .impact-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-top: 64px;
        }

        .impact-card {
            background: var(--bg-elevated);
            border-radius: var(--radius-md);
            padding: 40px 28px;
            text-align: center;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            border-top: 4px solid var(--accent-gold);
            box-shadow: var(--shadow-sm);
        }

        .impact-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 100%;
            background: linear-gradient(135deg, rgba(201, 169, 97, 0.04) 0%, transparent 60%);
            pointer-events: none;
        }

        .impact-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
        }

        .impact-emoji {
            font-size: 48px;
            margin-bottom: 16px;
            display: block;
        }

        .impact-amount {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            font-weight: 700;
            color: var(--accent-warm);
            margin-bottom: 12px;
            letter-spacing: -1px;
        }

        .impact-description {
            font-size: 15px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        /* ============================================
           Gallery Section
           ============================================ */
        .gallery {
            padding: var(--section-pad-y) 0;
            background: var(--bg-primary);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 64px;
        }

        .gallery-item {
            position: relative;
            border-radius: var(--radius-md);
            overflow: hidden;
            aspect-ratio: 3/4;
            cursor: pointer;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
        }

        .gallery-item:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.05);
        }

        .gallery-caption {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 32px 20px 20px;
            background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
            color: white;
            font-size: 14px;
            font-weight: 500;
            opacity: 0;
            transition: var(--transition);
        }

        .gallery-item:hover .gallery-caption {
            opacity: 1;
        }

        /* ============================================
           Documents Section
           ============================================ */
        .documents {
            padding: var(--section-pad-y) 0;
            background: var(--bg-warm);
        }

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 32px;
            margin-top: 64px;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .doc-card {
            background: var(--bg-elevated);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            cursor: pointer;
            position: relative;
        }

        .doc-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

        .doc-image {
            aspect-ratio: 3/4;
            overflow: hidden;
            background: #f5f5f5;
        }

        .doc-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .doc-card:hover .doc-image img {
            transform: scale(1.03);
        }

        .doc-info {
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .doc-title {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 15px;
            line-height: 1.4;
        }

        .doc-verified {
            background: rgba(76, 175, 80, 0.1);
            color: var(--success);
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* ============================================
           Donation Section
           ============================================ */
        .donation {
            padding: var(--section-pad-y) 0;
            background: var(--bg-primary);
        }

        .donation-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 64px;
        }

        .bank-card {
            background: var(--bg-elevated);
            border-radius: var(--radius-md);
            padding: 32px 28px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid rgba(201, 169, 97, 0.15);
        }

        .bank-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-gold), var(--accent-gold-dark));
        }

        .bank-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
        }

        .bank-name {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 20px;
        }

        .bank-number {
            font-family: 'Inter', monospace;
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: 1.5px;
            margin-bottom: 24px;
            background: var(--bg-warm);
            padding: 16px;
            border-radius: var(--radius-sm);
            text-align: center;
            word-break: break-all;
        }

        .bank-copy-btn {
            width: 100%;
            background: var(--accent-gold);
            color: white;
            padding: 14px;
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .bank-copy-btn:hover {
            background: var(--accent-gold-dark);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .bank-copy-btn.copied {
            background: var(--success);
        }

        .bank-holder {
            margin-top: 16px;
            font-size: 13px;
            color: var(--text-muted);
            text-align: center;
            line-height: 1.5;
        }

        .bank-holder strong {
            color: var(--text-secondary);
            font-weight: 600;
        }

        .whatsapp-cta-wrap {
            text-align: center;
            margin-top: 64px;
        }

        .whatsapp-cta {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: var(--whatsapp);
            color: white;
            padding: 18px 40px;
            border-radius: 999px;
            font-size: 16px;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: 0 8px 28px rgba(37, 211, 102, 0.35);
        }

        .whatsapp-cta:hover {
            background: #1eba56;
            transform: translateY(-2px);
            box-shadow: 0 12px 36px rgba(37, 211, 102, 0.45);
        }

        .whatsapp-cta-icon {
            font-size: 22px;
        }

        /* ============================================
           Share Section
           ============================================ */
        .share {
            padding: var(--section-pad-y) 0;
            background: var(--bg-warm);
        }

        .share-buttons {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 56px;
            flex-wrap: wrap;
        }

        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 16px 32px;
            border-radius: 999px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: var(--shadow-md);
            min-width: 200px;
            justify-content: center;
        }

        .share-btn:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .share-btn-icon {
            font-size: 20px;
        }

        .share-btn.whatsapp {
            background: var(--whatsapp);
        }

        .share-btn.facebook {
            background: var(--facebook);
        }

        .share-btn.instagram {
            background: linear-gradient(135deg, #E1306C, #C13584, #833AB4);
        }

        /* ============================================
           Footer
           ============================================ */
        footer {
            padding: 80px 0 40px;
            background: var(--text-primary);
            color: rgba(255, 255, 255, 0.8);
            text-align: center;
        }

        .footer-text {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-style: italic;
            color: var(--accent-gold);
            margin-bottom: 32px;
            line-height: 1.6;
        }

        .footer-contact {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 32px;
            line-height: 1.8;
        }

        .footer-copyright {
            padding-top: 32px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 13px;
            color: rgba(255, 255, 255, 0.4);
        }

        /* ============================================
           Lightbox
           ============================================ */
        .lightbox {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.92);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .lightbox.active {
            display: flex;
            opacity: 1;
        }

        .lightbox img {
            max-width: 90vw;
            max-height: 90vh;
            object-fit: contain;
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-xl);
        }

        .lightbox-close {
            position: absolute;
            top: 24px;
            right: 24px;
            color: white;
            font-size: 32px;
            background: rgba(255, 255, 255, 0.1);
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        /* ============================================
           Toast Notification
           ============================================ */
        .toast {
            position: fixed;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--text-primary);
            color: white;
            padding: 16px 28px;
            border-radius: 999px;
            font-weight: 600;
            font-size: 15px;
            box-shadow: var(--shadow-xl);
            z-index: 999;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 10px;
            pointer-events: none;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        .toast-icon {
            color: var(--success);
            font-weight: 800;
            font-size: 18px;
        }

        /* ============================================
           Floating Donate Button (above WhatsApp btn)
           ============================================ */
        .floating-donate {
            position: fixed;
            bottom: 110px; /* 30px (WA bottom) + 65px (WA size) + 15px gap */
            right: 30px;
            background: var(--accent-gold);
            color: white;
            padding: 14px 24px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 8px 28px rgba(201, 169, 97, 0.5);
            z-index: 9997;
            display: none;
            align-items: center;
            gap: 8px;
            animation: floatIn 0.5s ease;
            transition: var(--transition);
        }

        .floating-donate.visible {
            display: inline-flex;
        }

        .floating-donate:hover {
            background: var(--accent-gold-dark);
            transform: translateY(-3px);
            box-shadow: 0 12px 36px rgba(201, 169, 97, 0.6);
        }

        @keyframes floatIn {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============================================
           Responsive — Tablet
           ============================================ */
        @media (max-width: 1024px) {
            :root {
                --section-pad-y: 80px;
            }

            .story-grid {
                gap: 48px;
            }

            .impact-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .donation-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
            }
        }

        /* ============================================
           Responsive — Mobile
           ============================================ */
        @media (max-width: 768px) {
            :root {
                --section-pad-y: 60px;
            }

            body {
                font-size: 16px;
            }

            .container {
                padding: 0 20px;
            }

            /* Nav — lang switcher inline (compact), hamburger removed */
            .nav-right .btn-cta {
                display: none; /* hero CTA + floating donate already cover this */
            }

            .nav-right .lang-switcher {
                padding: 3px;
                gap: 2px;
            }

            .nav-right .lang-btn {
                padding: 5px 10px;
                font-size: 12px;
                letter-spacing: 0.2px;
            }

            .nav-mobile-toggle {
                display: none; /* lang switcher is inline now */
            }

            .nav.mobile-open .nav-mobile-menu {
                display: flex;
            }

            .nav-mobile-menu {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: var(--bg-primary);
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 32px;
                z-index: 99;
            }

            .nav-mobile-menu .lang-switcher {
                display: flex;
                background: var(--bg-warm);
            }

            .nav-mobile-menu .lang-btn {
                color: var(--text-primary);
            }

            .nav-mobile-menu .btn-cta {
                font-size: 18px;
                padding: 16px 36px;
            }

            .nav-mobile-close {
                position: absolute;
                top: 24px;
                right: 24px;
                font-size: 32px;
                color: var(--text-primary);
                background: var(--bg-warm);
                width: 48px;
                height: 48px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Hero */
            .hero-title {
                letter-spacing: -2px;
            }

            .last-updated-badge {
                top: 88px; /* clears 44px hamburger button (top ~20-64px) with breathing room */
                right: 16px;
                font-size: 11px;
                padding: 6px 12px;
            }

            /* Move scroll indicator above floating WhatsApp button (60px circle @ bottom 20px = clears at 80px) */
            .scroll-indicator {
                bottom: 120px; /* 40px clearance from WhatsApp button top edge */
                font-size: 14px;
                letter-spacing: 2.2px;
                gap: 12px;
            }

            .scroll-chevron,
            .scroll-chevron-2 {
                width: 20px;
                height: 20px;
            }

            .scroll-chevron-2 {
                margin-top: -10px;
            }

            /* Story */
            .story-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .story-image {
                max-width: 400px;
                margin: 0 auto;
            }

            .story-text .lead {
                font-size: 20px;
            }

            /* Impact - 2x2 */
            .impact-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }

            .impact-card {
                padding: 28px 16px;
            }

            .impact-amount {
                font-size: 28px;
            }

            .impact-emoji {
                font-size: 36px;
            }

            .impact-description {
                font-size: 13px;
            }

            /* Gallery */
            .gallery-grid {
                grid-template-columns: 1fr;
                gap: 16px;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }

            .gallery-caption {
                opacity: 1;
                font-size: 12px;
                padding: 20px 16px 14px;
            }

            /* Documents */
            .docs-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            /* Donation */
            .donation-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .bank-number {
                font-size: 18px;
                letter-spacing: 1px;
            }

            .whatsapp-cta {
                width: 100%;
                max-width: 360px;
                padding: 16px 24px;
                font-size: 15px;
            }

            /* Share */
            .share-buttons {
                flex-direction: column;
                gap: 12px;
            }

            .share-btn {
                width: 100%;
                max-width: 320px;
                margin: 0 auto;
            }

            /* Floating donate (above WhatsApp btn on mobile) */
            .floating-donate {
                bottom: 92px; /* 20 (WA) + 60 (WA size) + 12 gap */
                right: 20px;
                padding: 11px 18px;
                font-size: 13px;
            }

            footer {
                padding: 56px 0 32px;
            }

            .footer-text {
                font-size: 18px;
            }
        }

        /* Very small phones — tighter scroll indicator */
        @media (max-width: 400px) {
            .scroll-indicator {
                font-size: 12px;
                letter-spacing: 1.8px;
                bottom: 130px;
                gap: 10px;
            }

            .scroll-chevron,
            .scroll-chevron-2 {
                width: 18px;
                height: 18px;
            }

            .scroll-chevron-2 {
                margin-top: -9px;
            }
        }

        @media (max-width: 380px) {
            .hero-title {
                font-size: 48px;
            }

            .hero-subtitle {
                font-size: 16px;
            }

            .impact-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ============================================
           Floating WhatsApp Button
           ============================================ */
        .float-whatsapp {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 65px;
            height: 65px;
            background: #25D366;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
            z-index: 9998;
            opacity: 0;
            transform: translateY(100px) scale(0.8);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, box-shadow 0.3s ease, background 0.3s ease;
            will-change: transform, opacity;
        }

        .float-whatsapp.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            animation: whatsappPulse 3s ease-in-out 2s infinite;
        }

        .float-whatsapp:hover {
            transform: translateY(0) scale(1.1);
            background: #1eba56;
            box-shadow: 0 6px 24px rgba(37, 211, 102, 0.55);
            animation-play-state: paused;
        }

        .float-whatsapp:active {
            transform: translateY(0) scale(1.05);
        }

        .float-whatsapp svg {
            width: 32px;
            height: 32px;
            fill: white;
            display: block;
            pointer-events: none;
        }

        @keyframes whatsappPulse {
            0%, 100% {
                transform: translateY(0) scale(1);
                box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
            }
            50% {
                transform: translateY(0) scale(1.05);
                box-shadow: 0 6px 22px rgba(37, 211, 102, 0.55), 0 0 0 10px rgba(37, 211, 102, 0.08);
            }
        }

        /* WhatsApp Tooltip (desktop hover only) */
        .float-whatsapp-tooltip {
            position: absolute;
            right: calc(100% + 14px);
            top: 50%;
            transform: translateY(-50%);
            background: #FFFFFF;
            color: var(--text-primary);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
            white-space: nowrap;
            box-shadow: 0 4px 14px rgba(44, 36, 22, 0.15);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            letter-spacing: normal;
            text-transform: none;
        }

        .float-whatsapp-tooltip::after {
            content: '';
            position: absolute;
            left: 100%;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            border-left: 6px solid #FFFFFF;
        }

        @media (hover: hover) and (pointer: fine) {
            .float-whatsapp:hover .float-whatsapp-tooltip {
                opacity: 1;
            }
        }

        @media (max-width: 768px) {
            .float-whatsapp {
                bottom: 20px;
                right: 20px;
                width: 60px;
                height: 60px;
            }

            .float-whatsapp svg {
                width: 30px;
                height: 30px;
            }

            .float-whatsapp-tooltip {
                display: none;
            }
        }

        /* Hide floating WhatsApp + donate when mobile menu is open */
        .nav.mobile-open ~ .float-whatsapp,
        .nav.mobile-open ~ .floating-donate {
            opacity: 0;
            pointer-events: none;
            transform: translateY(20px);
        }

        /* ============================================
           Reduced Motion (accessibility)
           ============================================ */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }

            .reveal {
                opacity: 1 !important;
                transform: none !important;
            }

            .float-whatsapp.visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            .scroll-chevron,
            .scroll-chevron-2,
            .float-whatsapp,
            .hero-cta {
                animation: none !important;
            }
        }

        /* ============================================
           Transfer Guide Modal (post-copy instructions)
           Replaces unreliable bank deep linking with clear instructions.
           ============================================ */
        .transfer-guide {
            position: fixed;
            inset: 0;
            z-index: 1100;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .transfer-guide.active {
            opacity: 1;
            visibility: visible;
        }

        .transfer-guide-content {
            background: var(--bg-primary);
            width: 100%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            border-radius: var(--radius-lg);
            padding: 32px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            transform: scale(0.95);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            will-change: transform;
        }

        .transfer-guide.active .transfer-guide-content {
            transform: scale(1);
        }

        .transfer-guide-close {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--bg-warm);
            color: var(--text-secondary);
            font-size: 22px;
            font-weight: 400;
            line-height: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: none;
            transition: background 0.2s ease, color 0.2s ease, transform 0.3s ease;
            z-index: 2;
        }

        .transfer-guide-close:hover {
            background: rgba(0, 0, 0, 0.08);
            color: var(--text-primary);
            transform: rotate(90deg);
        }

        .transfer-guide-header {
            text-align: center;
            margin-bottom: 24px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        }

        .transfer-guide-checkmark {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #4CAF50;
            color: white;
            font-size: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-weight: 700;
        }

        .transfer-guide-title {
            font-family: 'Playfair Display', Georgia, serif;
            font-size: 22px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 10px;
            letter-spacing: -0.3px;
        }

        .transfer-guide-card-number {
            font-family: 'Inter', monospace;
            font-size: 17px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: 1.2px;
            background: var(--bg-warm);
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            display: inline-block;
            user-select: text;
            -webkit-user-select: text;
        }

        .transfer-guide-section {
            margin-bottom: 26px;
        }

        .transfer-guide-section:last-of-type {
            margin-bottom: 12px;
        }

        .transfer-guide-section-title {
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .transfer-guide-steps {
            list-style: none;
            padding: 0;
            counter-reset: step;
        }

        .transfer-guide-steps li {
            counter-increment: step;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 10px 0;
            color: var(--text-secondary);
            font-size: 15px;
            line-height: 1.5;
        }

        .transfer-guide-steps li::before {
            content: counter(step);
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--accent-gold);
            color: white;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .transfer-guide-apps {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .transfer-guide-app {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            padding: 14px 10px;
            background: var(--bg-warm);
            border-radius: var(--radius-md);
            color: var(--text-primary);
            border: 1px solid transparent;
            transition: background 0.2s ease, border-color 0.2s ease;
            text-decoration: none;
        }

        .transfer-guide-app:hover {
            background: rgba(201, 169, 97, 0.12);
            border-color: var(--accent-gold);
        }

        .transfer-guide-app-logo {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Playfair Display', serif;
            font-size: 16px;
            font-weight: 700;
            color: white;
            flex-shrink: 0;
        }

        .transfer-guide-app-logo.m10     { background: linear-gradient(135deg, #1a1a1a, #333); }
        .transfer-guide-app-logo.kapital { background: linear-gradient(135deg, #c91c39, #8b1428); }
        .transfer-guide-app-logo.leobank { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
        .transfer-guide-app-logo.abb     { background: linear-gradient(135deg, #047857, #064e3b); }

        .transfer-guide-app-name {
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            color: var(--text-primary);
        }

        .transfer-guide-app-download {
            font-size: 11px;
            color: var(--accent-warm);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .transfer-guide-footer {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid rgba(0, 0, 0, 0.08);
        }

        .transfer-guide-thanks {
            font-family: 'Playfair Display', Georgia, serif;
            font-style: italic;
            font-size: 17px;
            color: var(--accent-warm);
            margin-bottom: 14px;
        }

        .transfer-guide-close-btn {
            width: 100%;
            padding: 14px;
            background: var(--accent-gold);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.2s ease, transform 0.2s ease;
        }

        .transfer-guide-close-btn:hover {
            background: var(--accent-gold-dark);
            transform: translateY(-1px);
        }

        @media (max-width: 768px) {
            .transfer-guide { padding: 12px; }
            .transfer-guide-content {
                padding: 24px 20px;
                max-height: 92vh;
            }
            .transfer-guide-title { font-size: 19px; }
            .transfer-guide-card-number { font-size: 15px; letter-spacing: 1px; }
            .transfer-guide-section-title { font-size: 14px; }
            .transfer-guide-steps li { font-size: 14px; gap: 12px; padding: 8px 0; }
            .transfer-guide-steps li::before { width: 26px; height: 26px; font-size: 13px; }
            .transfer-guide-app { padding: 12px 8px; }
            .transfer-guide-app-logo { width: 34px; height: 34px; font-size: 14px; }
            .transfer-guide-app-name { font-size: 12px; }
            .transfer-guide-thanks { font-size: 15px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .transfer-guide,
            .transfer-guide-content,
            .transfer-guide-close {
                transition: none;
            }
        }

        /* Print friendly */
        @media print {
            .nav, .floating-donate, .float-whatsapp, .hero-cta, .scroll-indicator, .transfer-guide { display: none; }
        }
    </style>
</head>
<body>
    <!-- ============================================
         Navigation
         ============================================ -->
    <nav class="nav" id="nav">
        <div class="nav-inner">
            <a href="#" class="nav-logo serif">Yusif</a>
            <div class="nav-right">
                <div class="lang-switcher" role="group" aria-label="Language">
                    <button class="lang-btn active" data-lang="az" type="button">AZ</button>
                    <button class="lang-btn" data-lang="ru" type="button">RU</button>
                    <button class="lang-btn" data-lang="en" type="button">EN</button>
                </div>
                <a href="#donation" class="btn-cta" data-i18n="navCta">Kömək et</a>
            </div>
            <button class="nav-mobile-toggle" id="mobileToggle" type="button" aria-label="Menu">☰</button>
        </div>
        <div class="nav-mobile-menu" id="mobileMenu">
            <button class="nav-mobile-close" id="mobileClose" type="button" aria-label="Close">×</button>
            <div class="lang-switcher" role="group" aria-label="Language">
                <button class="lang-btn active" data-lang="az" type="button">AZ</button>
                <button class="lang-btn" data-lang="ru" type="button">RU</button>
                <button class="lang-btn" data-lang="en" type="button">EN</button>
            </div>
            <a href="#donation" class="btn-cta" data-i18n="navCta">Kömək et</a>
        </div>
    </nav>

    <!-- ============================================
         Hero
         ============================================ -->
    <section class="hero" id="hero">
        <div class="hero-bg" id="heroBg"></div>
        <div class="last-updated-badge">
            📅 <span data-i18n="lastUpdated">Son yenilənmə</span>: <span id="lastUpdatedDate"></span>
        </div>
        <div class="hero-content">
            <h1 class="hero-title">Yusif.</h1>
            <p class="hero-subtitle" data-i18n="heroSubtitle">11 yaş. Qan xərçəngi. Sənin köməyinə möhtac.</p>
        </div>
        <div class="scroll-indicator" id="scrollIndicator" role="button" tabindex="0" aria-label="Aşağı sürüşdür">
            <span data-i18n="scrollIndicatorText">Yusifin hekayəsini oxu</span>
            <div class="scroll-indicator-arrows" aria-hidden="true">
                <svg class="scroll-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                <svg class="scroll-chevron scroll-chevron-2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </div>
        </div>
    </section>

    <!-- ============================================
         Story
         ============================================ -->
    <section class="story" id="story">
        <div class="container">
            <h2 class="section-title reveal" data-i18n="storyTitle">Yusifin hekayəsi</h2>
            <div class="story-grid">
                <div class="story-image reveal">
                    <img src="yusif1.jpg" alt="Yusif" loading="lazy" decoding="async" width="600" height="750">
                </div>
                <div class="story-text reveal reveal-delay-2">
                    <p class="lead" data-i18n="storyLead">"Mən Gülər. Yusifin anası."</p>
                    <p data-i18n="storyP1">Bir ana olaraq bu sözləri yazmaq mənim üçün çox ağırdır. Amma övladımın həyatı üçün kömək istəməkdən başqa yolum qalmayıb.</p>
                    <p data-i18n="storyP2">Oğlum <strong>Yusif 11 yaşındadır</strong> və 2023-cü ildən bəri qan xərçəngi ilə mübarizə aparır. İlik transplantasiyası olunub, amma indi GVHD ilə döyüşür.</p>
                    <p data-i18n="storyP3"><strong>Həkimlər deyirlər: müalicə fasiləsiz davam etməlidir.</strong> Yarımçıq qalsa, oğlumun həyatı təhlükədədir.</p>
                    <p data-i18n="storyP4">Atası fəhləlik edir, mən təmizliyə gedirəm. Bütün imkanlarımız tükənib. Sizdən kömək diləyirik.</p>
                    <div class="story-signature" data-i18n="storySignature">— Gülər, Yusifin anası</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         Impact
         ============================================ -->
    <section class="impact" id="impact">
        <div class="container">
            <h2 class="section-title reveal" data-i18n="impactTitle">Bir bağışın həqiqi gücü</h2>
            <p class="section-subtitle reveal reveal-delay-1" data-i18n="impactSubtitle">Hər manat Yusifin müalicəsinə birbaşa təsir edir</p>
            <div class="impact-grid">
                <div class="impact-card reveal reveal-delay-1">
                    <span class="impact-emoji">💊</span>
                    <div class="impact-amount">10 AZN</div>
                    <div class="impact-description" data-i18n="impact1">1 dərman dozası</div>
                </div>
                <div class="impact-card reveal reveal-delay-2">
                    <span class="impact-emoji">🩺</span>
                    <div class="impact-amount">50 AZN</div>
                    <div class="impact-description" data-i18n="impact2">Bir analiz və ya müayinə</div>
                </div>
                <div class="impact-card reveal reveal-delay-3">
                    <span class="impact-emoji">🏥</span>
                    <div class="impact-amount">100 AZN</div>
                    <div class="impact-description" data-i18n="impact3">Xəstəxana xərclərinin bir hissəsi</div>
                </div>
                <div class="impact-card reveal reveal-delay-4">
                    <span class="impact-emoji">💉</span>
                    <div class="impact-amount">500 AZN</div>
                    <div class="impact-description" data-i18n="impact4">Bir həftəlik müalicə paketi</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         Gallery
         ============================================ -->
    <section class="gallery" id="gallery">
        <div class="container">
            <h2 class="section-title reveal" data-i18n="galleryTitle">Yusifin gözündən</h2>
            <p class="section-subtitle reveal reveal-delay-1" data-i18n="gallerySubtitle">Xəstəxanada keçən günlər</p>
            <div class="gallery-grid">
                <div class="gallery-item reveal reveal-delay-1" data-img="yusif1.jpg">
                    <img src="yusif1.jpg" alt="Yusif" loading="lazy" decoding="async" width="600" height="800">
                    <div class="gallery-caption" data-i18n="galleryCaption1">Yusif — müalicə günlərində</div>
                </div>
                <div class="gallery-item reveal reveal-delay-2" data-img="yusif2.jpg">
                    <img src="yusif2.jpg" alt="Yusif" loading="lazy" decoding="async" width="600" height="800">
                    <div class="gallery-caption" data-i18n="galleryCaption2">Yusif — xəstəxanada</div>
                </div>
                <div class="gallery-item reveal reveal-delay-3" data-img="yusif3.jpg">
                    <img src="yusif3.jpg" alt="Yusif" loading="lazy" decoding="async" width="600" height="800">
                    <div class="gallery-caption" data-i18n="galleryCaption3">Yusif — ümidlə</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         Documents
         ============================================ -->
    <section class="documents" id="documents">
        <div class="container">
            <h2 class="section-title reveal" data-i18n="docsTitle">Şəffaflıq və həqiqət</h2>
            <p class="section-subtitle reveal reveal-delay-1" data-i18n="docsSubtitle">Bütün məlumatlar real və yoxlanılıbdır</p>
            <div class="docs-grid">
                <div class="doc-card reveal reveal-delay-1" data-img="document1.jpg">
                    <div class="doc-image">
                        <img src="document1.jpg" alt="Medical Park sənədi" loading="lazy" decoding="async" width="600" height="800">
                    </div>
                    <div class="doc-info">
