                footerCopyright: "Поддержка Yusif-а",

                floatingBtn: "Помочь",

                monthNames: ["Январь","Февраль","Март","Апрель","Май","Июнь","Июль","Август","Сентябрь","Октябрь","Ноябрь","Декабрь"]
            },
            en: {
                navCta: "Donate",
                lastUpdated: "Last updated",
                heroSubtitle: "11 years old. Blood cancer. In need of your help.",
                heroCta: "Donate",
                scrollHint: "SCROLL",
                scrollIndicatorText: "Read Yusif's story",
                whatsappTooltip: "Message mom - Gülər 💛",

                storyTitle: "Yusif's Story",
                storyLead: "\"I am Gülər. Yusif's mother.\"",
                storyP1: "As a mother, writing these words is very hard for me. But for the sake of my child's life, I have no choice but to ask for help.",
                storyP2: "My son <strong>Yusif is 11 years old</strong> and has been fighting blood cancer since 2023. He underwent a bone marrow transplant, but is now fighting graft-versus-host disease (GVHD).",
