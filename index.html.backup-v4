    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
        <button class="lightbox-close" id="lightboxClose" aria-label="Close">×</button>
        <img id="lightboxImg" src="" alt="">
    </div>

    <!-- Transfer instructions modal (opens after card copy) -->
    <div class="transfer-guide" id="transferGuide" role="dialog" aria-modal="true" aria-labelledby="transferGuideTitle">
        <div class="transfer-guide-content" role="document">
            <button class="transfer-guide-close" id="transferGuideCloseX" type="button" aria-label="Close">×</button>

            <div class="transfer-guide-header">
                <div class="transfer-guide-checkmark" aria-hidden="true">✓</div>
                <h3 class="transfer-guide-title" id="transferGuideTitle" data-i18n="transferTitle">Kart nömrəsi kopyalandı!</h3>
                <div class="transfer-guide-card-number" id="transferGuideCardNumber" aria-label="Copied card number"></div>
            </div>

            <div class="transfer-guide-section">
                <div class="transfer-guide-section-title">
                    💳 <span data-i18n="transferHowTitle">Necə köçürmək?</span>
                </div>
                <ol class="transfer-guide-steps">
                    <li data-i18n="transferStep1">Bank tətbiqinizi açın</li>
                    <li data-i18n="transferStep2">Köçürmə / Pul göndər seçin</li>
                    <li data-i18n="transferStep3">Kart nömrəsi sahəsinə yapışdırın (basıb saxlayın → Yapışdır)</li>
                    <li data-i18n="transferStep4">Məbləği yazın və göndərin</li>
                </ol>
            </div>

            <div class="transfer-guide-section">
                <div class="transfer-guide-section-title">
                    📱 <span data-i18n="transferNoAppTitle">Tətbiqim yoxdur</span>
                </div>
                <div class="transfer-guide-apps">
                    <a class="transfer-guide-app"
                       data-ios="https://apps.apple.com/az/app/m10-mobile-cüzdan/id1473023153"
                       data-android="https://play.google.com/store/apps/details?id=az.azericard.m10"
                       href="https://play.google.com/store/apps/details?id=az.azericard.m10"
                       target="_blank" rel="noopener noreferrer">
                        <span class="transfer-guide-app-logo m10" aria-hidden="true">m10</span>
                        <span class="transfer-guide-app-name">m10</span>
                        <span class="transfer-guide-app-download">↓ <span data-i18n="transferDownload">Endir</span></span>
                    </a>
                    <a class="transfer-guide-app"
                       data-ios="https://apps.apple.com/az/app/birbank/id1486177830"
                       data-android="https://play.google.com/store/apps/details?id=az.kapitalbank.android"
                       href="https://play.google.com/store/apps/details?id=az.kapitalbank.android"
                       target="_blank" rel="noopener noreferrer">
                        <span class="transfer-guide-app-logo kapital" aria-hidden="true">K</span>
                        <span class="transfer-guide-app-name">Kapital Bank</span>
                        <span class="transfer-guide-app-download">↓ <span data-i18n="transferDownload">Endir</span></span>
                    </a>
                    <a class="transfer-guide-app"
                       data-ios="https://apps.apple.com/az/app/leobank/id1530924900"
                       data-android="https://play.google.com/store/apps/details?id=az.leobank.mobile"
                       href="https://play.google.com/store/apps/details?id=az.leobank.mobile"
                       target="_blank" rel="noopener noreferrer">
                        <span class="transfer-guide-app-logo leobank" aria-hidden="true">L</span>
                        <span class="transfer-guide-app-name">LeoBank</span>
                        <span class="transfer-guide-app-download">↓ <span data-i18n="transferDownload">Endir</span></span>
                    </a>
                    <a class="transfer-guide-app"
                       data-ios="https://apps.apple.com/az/app/abb-mobile/id1437299935"
                       data-android="https://play.google.com/store/apps/details?id=com.ibavi.abbmobile"
                       href="https://play.google.com/store/apps/details?id=com.ibavi.abbmobile"
                       target="_blank" rel="noopener noreferrer">
                        <span class="transfer-guide-app-logo abb" aria-hidden="true">A</span>
                        <span class="transfer-guide-app-name">ABB Mobile</span>
                        <span class="transfer-guide-app-download">↓ <span data-i18n="transferDownload">Endir</span></span>
                    </a>
                </div>
            </div>

            <div class="transfer-guide-footer">
                <p class="transfer-guide-thanks" data-i18n="transferThanks">💛 Allah razı olsun!</p>
                <button class="transfer-guide-close-btn" id="transferGuideCloseBtn" type="button" data-i18n="transferCloseBtn">Bağla</button>
            </div>
        </div>
    </div>

    <!-- Toast notification -->
    <div class="toast" id="toast">
        <span class="toast-icon">✓</span>
