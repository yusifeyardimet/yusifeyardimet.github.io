                        <span class="doc-verified" data-i18n="verified">✓ Yoxlanılıb</span>
                    </div>
                </div>
                <div class="doc-card reveal reveal-delay-2" data-img="document2.jpg">
                    <div class="doc-image">
                        <img src="document2.jpg" alt="Milli Hematologiya Mərkəzi epikriz" loading="lazy" decoding="async" width="600" height="800">
                    </div>
                    <div class="doc-info">
                        <span class="doc-title" data-i18n="doc2Title">Milli Hematologiya Mərkəzi — Epikriz</span>
                        <span class="doc-verified" data-i18n="verified">✓ Yoxlanılıb</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         Donation
         ============================================ -->
    <section class="donation" id="donation">
        <div class="container">
